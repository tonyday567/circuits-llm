packages:
  circuits-llm.cabal
  ../circuits-ad/circuits-ad.cabal
  ../circuits/circuits.cabal
  ../circuits-meter/circuits-meter.cabal
  ../numhask/numhask.cabal
  ../numhask-diff/numhask-diff.cabal
  ../harpie/harpie.cabal
  ../harpie-numhask/harpie-numhask.cabal

constraints:
  circuits >= 0.2,
  circuits-ad >= 0.1

write-ghc-environment-files: always

package recursion-schemes
  flags: -template-haskell

package harpie
  flags: +hmatrix
