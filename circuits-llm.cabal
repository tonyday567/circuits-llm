cabal-version: 3.0
name: circuits-llm
version: 0.1.0.0
license: BSD-3-Clause
author: Tony Day
maintainer: tonyday567@gmail.com
category: nlp
synopsis: Small language-model experiments with circuits and hmatrix
description:
  Experiments in training and inference for small transformer-style
  language models, using the circuits ecosystem and hmatrix for linear
  algebra.  Includes byte-pair encoding, attention, GPT-2-shaped
  forward/backward passes, and AdamW training loops.
build-type: Simple
tested-with: ghc ==9.14.1

source-repository head
  type: git
  location: https://github.com/tonyday567/circuits-llm

library
  exposed-modules:
    Circuit.LLM.BPE
    Circuit.LLM.Attention
    Circuit.LLM.GPT
    Circuit.LLM.Weights
    Circuit.LLM.Inference
    Circuit.LLM.Training
    Circuit.LLM.Backprop

  other-modules:
    Circuit.LLM.Diff

  build-depends:
    base >=4.20 && <5,
    bytestring >=0.11 && <0.13,
    circuits-ad >=0.1 && <0.2,
    containers >=0.6 && <0.9,
    deepseq >=1.5 && <1.6,
    harpie >=0.2 && <0.4,
    hmatrix >=0.20 && <0.21,
    random >=1.2 && <1.3,
    text >=2.0 && <3,
    vector >=0.13 && <0.14,

  hs-source-dirs: src
  default-language: GHC2024
  ghc-options:
    -O2
    -Wall
    -Wcompat

test-suite test-bpe
  type: exitcode-stdio-1.0
  main-is: test-bpe.hs
  build-depends:
    base >=4.20 && <5,
    circuits-llm >=0.1 && <0.2,
    text >=2.0 && <3,
    vector >=0.13 && <0.14,

  hs-source-dirs: app
  default-language: GHC2024
  ghc-options:
    -O2
    -Wall
    -Wcompat

