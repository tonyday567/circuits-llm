cabal-version: 3.0
name: circuits-llm
version: 0.1.0.0
license: BSD-3-Clause
license-file: LICENSE
copyright: Tony Day (c) 2026
category: nlp
author: Tony Day
maintainer: tonyday567@gmail.com
homepage: https://github.com/tonyday567/circuits-llm#readme
bug-reports: https://github.com/tonyday567/circuits-llm/issues
synopsis: Small language-model experiments with circuits and hmatrix
description:
  Experiments in training and inference for small transformer-style
  language models, using the circuits ecosystem and hmatrix for linear
  algebra.  Includes byte-pair encoding, attention, GPT-2-shaped
  forward/backward passes, and AdamW training loops.

build-type: Simple
tested-with:
  ghc ==9.10.1
  ghc ==9.12.2
  ghc ==9.14.1

source-repository head
  type: git
  location: https://github.com/tonyday567/circuits-llm

common ghc-options-stanza
  ghc-options:
    -Wall
    -Wno-unused-imports
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

library
  import: ghc-options-stanza
  default-language: GHC2024
  hs-source-dirs: src
  exposed-modules:
    Circuit.LLM.Attention
    Circuit.LLM.Backprop
    Circuit.LLM.BPE
    Circuit.LLM.GPT
    Circuit.LLM.Inference
    Circuit.LLM.Mixer
    Circuit.LLM.SSM
    Circuit.LLM.Training
    Circuit.LLM.Weights

  other-modules:
    Circuit.LLM.Diff

  build-depends:
    base >=4.20 && <5,
    bytestring >=0.11 && <0.13,
    circuits >=0.3 && <0.4,
    circuits-diff >=0.1 && <0.2,
    containers >=0.6 && <0.9,
    harpie >=0.3 && <0.4,
    hmatrix >=0.20 && <0.21,
    numhask >=0.14 && <0.15,
    random >=1.2 && <1.4,
    text >=1.2 && <3,
    vector >=0.12 && <0.14,

executable circuits-llm-ssm-axioma
  import: ghc-options-stanza
  default-language: GHC2024
  hs-source-dirs: app
  main-is: ssm-axioma.hs
  build-depends:
    base >=4.20 && <5,
    circuits >=0.3 && <0.4,
    circuits-llm >=0.1 && <0.2,
    harpie >=0.3 && <0.4,
    vector >=0.12 && <0.14,
