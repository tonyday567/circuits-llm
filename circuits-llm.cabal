cabal-version: 3.0
name: circuits-llm
version: 0.1.0.0
license: BSD-3-Clause
author: Tony Day
maintainer: tonyday567@gmail.com
category: nlp
build-type: Simple
tested-with: ghc ==9.14.1

library
  exposed-modules:
    Circuit.LLM.BPE
    Circuit.LLM.Attention
    Circuit.LLM.GPT
    Circuit.LLM.Weights
    Circuit.LLM.Inference
    Circuit.LLM.Training
    Circuit.LLM.Backprop

  other-modules:
    Circuit.LLM.Diff

  build-depends:
    base >=4.20 && <5,
    bytestring,
    containers,
    deepseq,
    harpie,
    hmatrix,
    random,
    text,
    vector,

  hs-source-dirs: src
  default-language: GHC2024
  ghc-options:
    -O2
    -Wall
    -Wcompat

test-suite test-bpe
  type: exitcode-stdio-1.0
  main-is: test-bpe.hs
  build-depends:
    base >=4.20 && <5,
    circuits-llm,
    text,
    vector,

  hs-source-dirs: app
  default-language: GHC2024
  ghc-options: -O2
  ghc-options:
    -Wall
    -Wcompat
executable quick-test
  main-is: quick-test.hs
  hs-source-dirs: app
  build-depends: base, circuits-llm, text, bytestring, containers, vector
  default-language: GHC2024
  ghc-options: -O2

executable bench
  main-is: bench.hs
  hs-source-dirs: app
  build-depends:
    base >=4.20 && <5,
    bytestring,
    circuits-llm,
    circuits-meter,
    containers,
    text,
    vector
  default-language: GHC2024
  ghc-options: -O2
  ghc-options: -O2 -rtsopts
